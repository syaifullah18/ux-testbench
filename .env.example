# Copy to .env. Never commit .env.

SECRET_KEY=replace-with-a-long-random-string

# Where projects live. Several folders can be joined with ':' (';' on Windows), e.g. a private
# repo of studies next to the public example: PROJECTS_DIRS=projects:../my-private-studies
# PROJECTS_DIRS=projects

# One SQLite file per project is created here.
# DATA_DIR=instance

# Per-project passcodes: <SLUG>_PASSCODE for participants, <SLUG>_ADMIN_PASSCODE for admins.
# The slug is upper-cased with '-' turned into '_'. A project whose passcode is unset stays closed.
EXAMPLE_ADMIN_PASSCODE=replace-me

# Optional: opens every project's admin, plus the /admin/ overview.
# SUPERADMIN_PASSCODE=

# Set to 1 when served over HTTPS.
# SESSION_COOKIE_SECURE=1
