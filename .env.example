# Copy to .env. Never commit .env.

SECRET_KEY=replace-with-a-long-random-string

# Opens the /admin/ overview and the Studio for every project: create, import, duplicate and
# delete projects from the browser. Give it only to the people who run studies.
SUPERADMIN_PASSCODE=replace-me

# Runtime data: one SQLite file per project, the passcode store, and DATA_DIR/projects,
# where projects created in the Studio live. Keep it out of git and back it up.
# DATA_DIR=instance

# Extra read-only project folders (the bundled example lives in ./projects). Join several
# with ':' (';' on Windows).
# PROJECTS_DIRS=projects

# Passcodes are normally set in the Studio. To manage one as configuration instead, set
# <SLUG>_PASSCODE or <SLUG>_ADMIN_PASSCODE (slug upper-cased, '-' becomes '_'); it then wins.
# EXAMPLE_ADMIN_PASSCODE=

# Upload limit for prototypes and project zips.
# MAX_UPLOAD_MB=50

# Set to 1 when served over HTTPS.
# SESSION_COOKIE_SECURE=1


# ---------------------------------------------------------------------------
# Public service mode. Leave TESTBENCH_MODE unset for an internal instance:
# one operator, a passcode per study, and none of the settings below apply.
# See docs/operations.md before running a public instance.
# ---------------------------------------------------------------------------

# TESTBENCH_MODE=public

# Who may create an account: open, invite (private beta), or closed.
# SIGNUP_MODE=invite

# The two domains. USERCONTENT_DOMAIN must be a separate registrable domain, not a
# subdomain, so prototype JavaScript can never reach an app cookie.
# APP_DOMAIN=testbench.example.org
# USERCONTENT_DOMAIN=testbench-usercontent.example
# ACME_EMAIL=ops@example.org

# Email. Without SMTP_URL, messages are written to the log instead of sent, so
# verification, password reset and invitations do not work for real users.
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM=UX Testbench <noreply@testbench.example.org>

# Serve CSS, fonts and icons from this instance, so participant pages make no
# third-party requests. Run ./scripts/build-assets.sh first.
# LOCAL_ASSETS=1

# Quotas. 0 means no limit. /app/admin/ shows the values in force.
# LIMIT_PROJECTS_PER_USER=10
# LIMIT_PARTICIPANTS_PER_PROJECT=2000
# LIMIT_SIGNUPS_PER_IP_PER_DAY=5
# LIMIT_UPLOAD_MB=10
# LIMIT_PROJECT_MB=100
