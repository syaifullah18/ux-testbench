# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Runtime data and secrets
instance/
.env

# Projects: only the example is public. Keep real studies in a private repo and point
# PROJECTS_DIRS at them, or keep them here untracked.
projects/*
!projects/example/

# Editors and OS
.DS_Store
.vscode/
.idea/

# Built assets and the downloaded Tailwind binary (scripts/build-assets.sh)
testbench/static/vendor/
.cache/
backups/

# Agent tooling and local coverage output. Skills are installed per developer, so they do not
# belong to the project's history; .claude/settings.json can be un-ignored below if the team
# ever wants to share permissions.
.claude/
.coverage
skills-lock.json
